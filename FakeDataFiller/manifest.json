{
  "manifest_version": 3,
  "name": "Fake Data Filler",
  "version": "1.0.0",
  "description": "Fills the forms on the current page with realistic fake data for testing sign-up and checkout flows.",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Fill forms with fake data (Alt+Shift+F)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill forms on the current page"
    }
  }
}
